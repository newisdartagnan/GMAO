# =====================================================================
#  Configuration de la pile GMAO
#
#      cp .env.example .env
#      ./scripts/verifier-ports.sh      # avant le premier démarrage
#      docker compose up -d
# =====================================================================

# ---------------------------------------------------------------------
#  PORTS PUBLIÉS SUR LE SERVEUR
#
#  Les quatre ports ci-dessous sont pris sur la machine hôte. Si l'un
#  d'eux est déjà utilisé par une autre application, Docker refuse de
#  démarrer le conteneur concerné avec « port is already allocated ».
#  Les changer ici suffit : rien d'autre n'en dépend, les conteneurs
#  communiquent entre eux par le réseau interne.
#
#  Pour savoir ce qui occupe un port :
#      docker ps --format '{{.Names}}\t{{.Ports}}'
#      sudo ss -tlnp | grep <port>
# ---------------------------------------------------------------------

# Interface web — c'est l'adresse que les agents ouvrent.
WEB_PORT=8080

# PostgreSQL, pour brancher pgAdmin, DBeaver ou psql depuis le poste.
# Ni l'API ni Adminer n'en ont besoin : ils passent par le réseau interne.
# 5432 est souvent pris par un PostgreSQL installé sur la machine, et 5433
# par une autre pile de conteneurs.
DB_PORT_HOTE=5434

# API, utile pour la mettre au point ou l'interroger directement.
# L'interface, elle, y accède par nginx sur WEB_PORT.
API_PORT_HOTE=3001

# Administration de la base (profil « admin » uniquement).
ADMINER_PORT=8081

# pgAdmin 4, pour reprendre les données à la main (profil « admin »).
PGADMIN_PORT=8082

# ---------------------------------------------------------------------
#  Secrets — à renseigner obligatoirement
#
#      openssl rand -base64 32
# ---------------------------------------------------------------------

# Mot de passe du compte PostgreSQL de l'application.
DB_PASSWORD=

# Clé de signature des jetons de session. La changer invalide les
# sessions ouvertes, ce qui est le comportement attendu.
JWT_SECRET=

# Accès à pgAdmin 4 (profil « admin »). Ce compte donne les pleins
# pouvoirs sur la base : le réserver à l'administrateur.
PGADMIN_EMAIL=admin@hopital.local
PGADMIN_PASSWORD=

# ---------------------------------------------------------------------
#  Base de données
# ---------------------------------------------------------------------
DB_NAME=gmao
DB_USER=gmao

# ---------------------------------------------------------------------
#  Session
# ---------------------------------------------------------------------
JWT_DUREE=12h

# ---------------------------------------------------------------------
#  Premier démarrage
# ---------------------------------------------------------------------

# À « true », la base vide est peuplée avec le jeu de démonstration d'un
# hôpital de référence. Passer à « false » pour démarrer sur une base
# vierge : seuls les comptes d'accès seront à créer.
SEED_AU_DEMARRAGE=true

# Mot de passe attribué aux comptes créés par le peuplement initial.
# À changer à la première connexion.
MOT_DE_PASSE_PAR_DEFAUT=gmao2026

# ---------------------------------------------------------------------
#  Planificateur des rondes (profil « planificateur »)
#
#  Compte technique utilisé pour ouvrir les créneaux d'inspection à
#  6 h 30 et 16 h 30. Lui donner le rôle « technicien » ou supérieur.
# ---------------------------------------------------------------------
COMPTE_SERVICE=
MOT_DE_PASSE_SERVICE=

# ---------------------------------------------------------------------
#  Formulaire externe de demande d'intervention
#
#  Le service de soins signale une panne depuis son téléphone : soit
#  en scannant le QR générique affiché dans les couloirs, soit en
#  scannant l'étiquette de l'équipement, qui pré-remplit son numéro
#  d'inventaire. La réponse devient une demande d'intervention.
#
#  Tout ce bloc est facultatif : sans lui, le connecteur reste en
#  sommeil et l'application fonctionne comme avant.
#
#  La procédure complète est dans le README, section « Recevoir les
#  demandes par formulaire ».
# ---------------------------------------------------------------------

# « microsoft » (Microsoft Forms), « jotform », ou vide.
FORMULAIRE_SOURCE=

# Lien public du formulaire, celui qu'ouvre le QR code des étiquettes.
#   https://forms.cloud.microsoft/r/XXXXXXXXXX
FORMULAIRE_URL=

# Paramètre d'URL qui reçoit le numéro d'inventaire pré-rempli.
#
#   Microsoft Forms attribue à chaque question un identifiant opaque.
#   Pour le connaître : ouvrir le formulaire dans l'éditeur, menu
#   « … » → « Obtenir un lien pré-rempli », remplir la seule question
#   du code, copier le lien produit et relever le nom du paramètre —
#   quelque chose comme « r8f3c1e0a4b24d0e9 ».
#
#   JotForm accepte directement le nom de la question.
FORMULAIRE_PARAM_CODE=

# Correspondance entre les questions du formulaire et les champs d'une
# demande, si les libellés en service ne sont pas reconnus. L'onglet
# Paramètres → Formulaire externe affiche les noms acceptés.
#   {"equipement":"Code inventaire","urgence":"Niveau de gravité"}
FORMULAIRE_CHAMPS=

# Secret exigé sur l'appel entrant, à recopier dans l'URL déclarée
# côté Power Automate ou JotForm :
#   https://gmao.hopital.cd/api/integrations/formulaire/<ce-secret>
# Laissé vide, la route refuse tout appel.
#     openssl rand -hex 24
FORMULAIRE_SECRET_WEBHOOK=

# Période de récupération, en minutes. Sans objet en mode webhook.
FORMULAIRE_INTERVALLE_MIN=5

# Compte au nom duquel sont ouvertes les demandes dont le déclarant
# n'est pas reconnu dans l'annuaire. Adresse ou matricule.
FORMULAIRE_COMPTE_SERVICE=

# ---------------------------------------------------------------------
#  Microsoft Forms — FORMULAIRE_SOURCE=microsoft
#
#  Microsoft Forms n'expose pas d'API de lecture des réponses : on ne
#  peut pas l'interroger. Les deux chemins passent par un flux Power
#  Automate déclenché à chaque soumission.
#
#  MSFORMS_MODE=webhook
#      Le flux appelle la GMAO. Immédiat, rien d'autre à installer,
#      mais le serveur doit être joignable depuis Internet.
#      → renseigner FORMULAIRE_SECRET_WEBHOOK ci-dessus, rien de plus.
#
#  MSFORMS_MODE=graph
#      Le flux ajoute une ligne dans un classeur Excel, que la GMAO
#      relit. Rien n'entre : c'est le serveur qui sort. C'est le mode
#      qui convient à une installation derrière la connexion de
#      l'hôpital, sans adresse publique.
# ---------------------------------------------------------------------
MSFORMS_MODE=webhook

# Inscription d'application dans Entra ID (mode « graph » seulement),
# avec l'autorisation d'application « Files.Read.All » consentie par
# l'administrateur du locataire.
MSFORMS_TENANT_ID=
MSFORMS_CLIENT_ID=
MSFORMS_CLIENT_SECRET=

# Emplacement du classeur alimenté par le flux. Deux écritures :
#   drive:<driveId>:/Documents/reponses-maintenance.xlsx
#   site:<hote>:/sites/<nom>:/Documents partages/reponses.xlsx
MSFORMS_CLASSEUR=

# Nom du tableau Excel dans ce classeur.
MSFORMS_TABLEAU=Tableau1

# ---------------------------------------------------------------------
#  JotForm — FORMULAIRE_SOURCE=jotform
# ---------------------------------------------------------------------

# Clé d'API : Paramètres du compte → API → Créer une nouvelle clé.
JOTFORM_API_KEY=

# Identifiant du formulaire : les chiffres à la fin de son URL.
JOTFORM_FORMULAIRE_ID=

# À remplacer par https://eu-api.jotform.com si le compte est hébergé
# dans la région européenne, sinon le formulaire sera introuvable
# alors qu'il existe bien.
JOTFORM_API_BASE=https://api.jotform.com

# ---------------------------------------------------------------------
#  Divers
# ---------------------------------------------------------------------
TZ=Africa/Kinshasa

# Origines autorisées à appeler l'API depuis un autre domaine. En
# production, l'interface et l'API partagent la même origine derrière
# nginx : cette liste ne sert qu'au développement.
CORS_ORIGINES=http://localhost:5173
