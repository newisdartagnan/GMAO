{
  "name": "@gmao/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API REST de la GMAO hospitalière",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --alias:@gmao/partage=../shared/src/index.ts --outfile=dist/index.js",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "migrer": "tsx src/cli/migrer.ts",
    "seed": "tsx src/cli/seed.ts",
    "verifier-mapping": "tsx src/cli/verifier-mapping.ts"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^9.0.1",
    "@gmao/partage": "*",
    "bcryptjs": "^2.4.3",
    "fastify": "^5.2.0",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "esbuild": "^0.24.2",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
